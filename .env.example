# Postgres (sans_dict, local). Used by the axum server / Vercel function, the importer,
# the seed script and drizzle-kit (schema/). On Vercel set this in the project env.
PG_DATABASE_URL=
# Production Postgres (PlanetScale). Selected with DB_MODE=PROD by drizzle-kit (schema/),
# scripts/seed.sh and scripts/db-dump.sh. Use a role inheriting `postgres` for migrations/seeding.
PG_DATABASE_URL1=
# Pool size per server instance (default 10; 2 on Vercel).
# DB_MAX_CONNECTIONS=
# Axum listen port (default 5780) and address (default 127.0.0.1).
# PORT=
# LISTEN_ADDR=
# Self-hosting: serve the built SPA from axum (frontend/.output/public).
# STATIC_DIR=
# Vite dev: override the /api proxy target.
# AXUM_DEV_ORIGIN=
# OpenRouter key for the dictionary agent (/agent): the chat models. Also used (public, cheap)
# by the vidyut tools to ask Jev (typesafe/jev-1.14, Decisions API) to pick among candidates.
OPENROUTER_API_KEY=
# OpenAI key for the agent's web_search tool (native OpenAI web search). Without it the agent
# answers from the dictionaries and omits the tool.
OPENAI_API_KEY=

# Better Auth server (tsc-users). The Rust API forwards the request cookie to
# `${VITE_BETTER_AUTH_URL}/api/auth/get-session` to gate the agent; the frontend's
# auth client talks to it directly. Same value goes in `frontend/.env.local`.
VITE_BETTER_AUTH_URL=http://localhost:5188