{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "complexity": ["warn", { "max": 21 }]
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/components/ui/**",
    ".output/**",
    ".tanstack/**",
    ".nitro/**",
    "dist/**"
  ]
}
